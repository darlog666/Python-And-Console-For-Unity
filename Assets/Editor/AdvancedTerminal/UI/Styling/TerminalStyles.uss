:root {
    --terminal-background: #1e1e1e;
    --terminal-panel: #252526;
    --terminal-elevated: #2d2d30;
    --terminal-border: #3c3c3c;
    --terminal-text: #d4d4d4;
    --terminal-muted: #9da5b4;
    --terminal-cyan: #00ced1;
    --terminal-emerald: #2ecc71;
    --terminal-crimson: #dc143c;
    --terminal-amber: #ffbf00;
    --terminal-violet: #9b59b6;
    --terminal-danger: #d32f2f;
    --terminal-mono: "Consolas", "Menlo", monospace;
}

.terminal-root {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background, var(--terminal-background));
    color: var(--terminal-text);
}

.terminal-toolbar {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: var(--terminal-elevated);
    border-bottom-width: 1px;
    border-bottom-color: var(--terminal-border);
}

.macro-binder-bar {
    flex-direction: row;
    flex-shrink: 0;
    margin-right: 8px;
}

.macro-button {
    -unity-font-style: bold;
    margin-right: 4px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: var(--terminal-panel);
    color: var(--terminal-cyan);
    border-width: 1px;
    border-color: var(--terminal-border);
    border-radius: 3px;
}

.macro-button:hover {
    background-color: var(--terminal-elevated);
    border-color: var(--terminal-cyan);
}

.toolbar-spacer {
    flex-grow: 1;
}

.kill-switch-button {
    -unity-font-style: bold;
    margin-left: 6px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: var(--terminal-danger);
    color: #ffffff;
    border-radius: 3px;
}

.kill-switch-button:hover {
    background-color: #ff1744;
}

.toggle-button-active {
    color: var(--terminal-emerald);
    border-color: var(--terminal-emerald);
}

.terminal-body {
    flex-direction: row;
    flex-grow: 1;
}

.left-sidebar {
    width: 260px;
    min-width: 180px;
    flex-shrink: 0;
    background-color: var(--terminal-panel);
    border-right-width: 1px;
    border-right-color: var(--terminal-border);
}

.center-panel {
    flex-grow: 1;
    min-width: 320px;
    background-color: var(--terminal-background);
}

.right-panel {
    width: 380px;
    min-width: 240px;
    flex-shrink: 0;
    background-color: var(--terminal-panel);
    border-left-width: 1px;
    border-left-color: var(--terminal-border);
}

.section-header {
    -unity-font-style: bold;
    font-size: 11px;
    color: var(--terminal-muted);
    padding-left: 8px;
    padding-top: 6px;
    padding-bottom: 4px;
    text-transform: uppercase;
}

.console-viewport {
    flex-grow: 1;
    background-color: var(--terminal-background);
    font-size: 12px;
}

.log-row {
    -unity-font: var(--terminal-mono);
    padding-left: 6px;
    padding-right: 6px;
    -unity-white-space: normal;
}

.console-input {
    margin: 4px;
    background-color: var(--terminal-elevated);
    border-width: 1px;
    border-color: var(--terminal-border);
    color: var(--terminal-cyan);
    -unity-font: var(--terminal-mono);
}

.console-input:focus {
    border-color: var(--terminal-cyan);
}

.status-strip {
    flex-direction: row;
    min-height: 20px;
    align-items: center;
    padding-left: 8px;
    background-color: var(--terminal-elevated);
    border-top-width: 1px;
    border-top-color: var(--terminal-border);
    color: var(--terminal-muted);
    font-size: 10px;
}

.suggestion-popup {
    position: absolute;
    bottom: 34px;
    left: 8px;
    min-width: 240px;
    max-width: 420px;
    background-color: var(--terminal-elevated);
    border-width: 1px;
    border-color: var(--terminal-border);
    border-radius: 4px;
}

.suggestion-item {
    padding-left: 8px;
    padding-right: 8px;
    -unity-font: var(--terminal-mono);
    color: var(--terminal-text);
}

.suggestion-item:hover {
    background-color: var(--terminal-panel);
    color: var(--terminal-cyan);
}

.ide-foldout {
    flex-grow: 1;
}

.ide-foldout > .unity-foldout__toggle {
    color: var(--terminal-violet);
    -unity-font-style: bold;
}

.ide-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
}

.tool-button {
    margin: 2px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: var(--terminal-elevated);
    color: var(--terminal-text);
    border-width: 1px;
    border-color: var(--terminal-border);
    border-radius: 3px;
    font-size: 11px;
}

.tool-button:hover {
    border-color: var(--terminal-emerald);
    color: var(--terminal-emerald);
}

.code-field {
    flex-grow: 1;
    background-color: var(--terminal-background);
    color: transparent;
    selection-background-color: rgba(0, 206, 209, 0.35);
    -unity-font: var(--terminal-mono);
    font-size: 12px;
    -unity-white-space: pre;
}

.code-field .unity-text-input-field__input {
    color: transparent;
    -unity-text-align: upper-left;
}

.gutter-scroll {
    flex-grow: 1;
}

.highlight-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    picking-mode: Ignore;
}

.highlight-row {
    -unity-font: var(--terminal-mono);
    font-size: 12px;
    -unity-white-space: pre;
    padding-left: 4px;
    -unity-text-align: upper-left;
}

.caret-readout {
    color: var(--terminal-muted);
    font-size: 10px;
    padding: 4px;
}

.workspace-tree {
    background-color: var(--terminal-panel);
}

.tree-element {
    color: var(--terminal-text);
}

.tree-element:selected {
    background-color: rgba(0, 206, 209, 0.2);
}

.variable-list {
    max-height: 140px;
}

.variable-row {
    -unity-font: var(--terminal-mono);
    font-size: 11px;
    color: var(--terminal-amber);
    padding-left: 6px;
}

.process-monitor {
    max-height: 160px;
}

.process-row {
    -unity-font: var(--terminal-mono);
    font-size: 11px;
    color: var(--terminal-muted);
    padding-left: 6px;
}

.flat-button {
    margin: 4px;
    background-color: var(--terminal-elevated);
    color: var(--terminal-cyan);
    border-radius: 3px;
}

.export-dropdown {
    margin-left: 6px;
    background-color: var(--terminal-panel);
    color: var(--terminal-text);
    border-width: 1px;
    border-color: var(--terminal-border);
}

.console-row-host {
    flex-direction: column;
}

.log-row-input {
    color: var(--terminal-cyan);
}

.log-row-success {
    color: var(--terminal-emerald);
}

.log-row-error {
    color: var(--terminal-crimson);
}

.log-row-warning {
    color: var(--terminal-amber);
}

.log-row-system {
    color: var(--terminal-violet);
}

.log-row-info {
    color: var(--terminal-muted);
}